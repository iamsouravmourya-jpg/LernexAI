# ==============================================================================
# LERNEXAI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your actual credentials.
# Never commit `.env` or your actual secrets to source control.
# ==============================================================================

# --- AI Models & LLM Providers ---
# Primary Google Gemini API Key for server-side generation
GEMINI_API_KEY=

# Groq Cloud API Keys for ultra-fast streaming AI Tutor (supports 4-key round-robin rotation & automatic failover)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY=

# --- Supabase Database & Authentication ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon Key (safe for client-side queries)
VITE_SUPABASE_ANON_KEY=

# Supabase Service Role Key (server-side only, allows administrative operations)
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment Gateway (Razorpay) ---
# Razorpay Key ID (Client-side & Server-side verification)
RAZORPAY_KEY_ID=
VITE_RAZORPAY_KEY_ID=

# Razorpay Key Secret (Server-side verification only, never expose to browser)
RAZORPAY_KEY_SECRET=

# --- Platform & Node Configuration ---
NODE_ENV=development

